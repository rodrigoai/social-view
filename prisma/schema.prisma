// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model MainAccount {
  id        String   @id @default(cuid())
  name      String   @default("My Business")
  googleBusinessUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  googleCredential      GoogleCredential?
  googleAdsConfigs      GoogleAdsConfig[]
  googleAnalyticsConfigs GoogleAnalyticsConfig[]
  googleSearchConsoleConfigs GoogleSearchConsoleConfig[]

  metaCredential        MetaCredential?
  metaAdsConfigs        MetaAdsConfig[]
  facebookPageConfigs   FacebookPageConfig[]
  instagramPageConfigs  InstagramPageConfig[]
}


model GoogleCredential {
  id            String   @id @default(cuid())
  mainAccountId String   @unique
  mainAccount   MainAccount @relation(fields: [mainAccountId], references: [id], onDelete: Cascade)
  
  refreshToken  String?
  accessToken   String?
  expiresAt     Float?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model GoogleAdsConfig {
  id            String   @id @default(cuid())
  mainAccountId String
  mainAccount   MainAccount @relation(fields: [mainAccountId], references: [id], onDelete: Cascade)
  
  customerId    String
  customerName  String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([mainAccountId, customerId])
}

model GoogleAnalyticsConfig {
  id            String   @id @default(cuid())
  mainAccountId String
  mainAccount   MainAccount @relation(fields: [mainAccountId], references: [id], onDelete: Cascade)
  
  propertyId    String
  propertyName  String?
  trackedEventName String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([mainAccountId, propertyId])
}

model GoogleSearchConsoleConfig {
  id            String   @id @default(cuid())
  mainAccountId String
  mainAccount   MainAccount @relation(fields: [mainAccountId], references: [id], onDelete: Cascade)
  
  siteUrl       String
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([mainAccountId, siteUrl])
}

model MetaCredential {
  id            String   @id @default(cuid())
  mainAccountId String   @unique
  mainAccount   MainAccount @relation(fields: [mainAccountId], references: [id], onDelete: Cascade)
  
  accessToken   String?
  longLivedToken String?
  expiresAt     Float?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MetaAdsConfig {
  id            String   @id @default(cuid())
  mainAccountId String
  mainAccount   MainAccount @relation(fields: [mainAccountId], references: [id], onDelete: Cascade)
  
  adAccountId   String
  adAccountName String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([mainAccountId, adAccountId])
}

model FacebookPageConfig {
  id            String   @id @default(cuid())
  mainAccountId String
  mainAccount   MainAccount @relation(fields: [mainAccountId], references: [id], onDelete: Cascade)
  
  pageId        String
  pageName      String?
  accessToken   String? // Pages often require their own page access token
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([mainAccountId, pageId])
}

model InstagramPageConfig {
  id            String   @id @default(cuid())
  mainAccountId String
  mainAccount   MainAccount @relation(fields: [mainAccountId], references: [id], onDelete: Cascade)
  
  igAccountId   String
  igAccountName String?
  facebookPageId String? // IG accounts are typically linked to an FB page
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([mainAccountId, igAccountId])
}

model InstagramFollowersHistory {
  id             String   @id @default(cuid())
  igAccountId    String
  date           DateTime
  followersCount Int

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([igAccountId, date])
  @@index([igAccountId, date])
}
